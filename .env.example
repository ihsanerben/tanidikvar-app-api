# scripts/setup-local.sh creates .env with a random local database password.
DB_NAME=tanidikvar
DB_USERNAME=tanidikvar
DB_PASSWORD=
DB_PORT=55432
SERVER_PORT=8080
CORS_ALLOWED_ORIGIN=http://localhost:5173
RATE_LIMIT_TRUSTED_PROXIES=
STORAGE_DIRECTORY=.local/storage

# Base64 encoded random key; setup-local.sh generates this locally.
JWT_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=14d
FRONTEND_URL=http://localhost:5173
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false
MAIL_FROM=noreply@tanidikvar.local
CONTACT_RECIPIENT=tanidikvar@gmail.com
# Local/test uses Mailpit through SMTP. Production uses MAIL_PROVIDER=resend and a
# Render-only RESEND_API_KEY; never commit that key to this file.
MAIL_PROVIDER=smtp
PILOT_MODE=false
RESEND_API_KEY=
RESEND_ENDPOINT=https://api.resend.com/emails

# Resmi YOK Atlas katalog senkronu yalnız Manager endpoint'i ile kontrollü başlatılır.
YOK_ATLAS_BASE_URL=https://yokatlas.yok.gov.tr/api
YOK_ATLAS_PAGE_SIZE=500
YOK_ATLAS_TIMEOUT=120s
