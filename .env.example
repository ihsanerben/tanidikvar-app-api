# scripts/setup-local.sh creates .env with a random local database password.
DB_NAME=tanidikvar
DB_USERNAME=tanidikvar
DB_PASSWORD=
DB_PORT=55432
SERVER_PORT=8080
CORS_ALLOWED_ORIGIN=http://localhost:5173
STORAGE_DIRECTORY=.local/storage

# Base64 encoded random key; setup-local.sh generates this locally.
JWT_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=14d
FRONTEND_URL=http://localhost:5173
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false
MAIL_FROM=noreply@tanidikvar.local
