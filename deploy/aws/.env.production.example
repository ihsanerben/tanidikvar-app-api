# Copy this file to .env.production on the EC2 server. Never commit the copy.
API_DOMAIN=api.tanidikvar.online
PORT=8080

# Neon: direct JDBC connection. Do not use the pooled host until Flyway is
# deliberately separated from the runtime datasource.
DB_URL=jdbc:postgresql://your-neon-direct-host/neondb?sslmode=require
DB_USERNAME=neondb_owner
DB_PASSWORD=

# Generate a new Base64 secret of at least 32 random bytes. A new value makes
# current browser sessions sign in again after the AWS cutover.
JWT_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=14d

COOKIE_SECURE=true
CORS_ALLOWED_ORIGIN=https://tanidikvar.online
FRONTEND_URL=https://tanidikvar.online
# Comma-separated CIDRs of direct reverse proxies. Never use 0.0.0.0/0.
RATE_LIMIT_TRUSTED_PROXIES=

MAIL_PROVIDER=resend
MAIL_FROM=TanıdıkVar <bildirim@tanidikvar.online>
RESEND_API_KEY=
RESEND_ENDPOINT=https://api.resend.com/emails

# The EC2 EBS volume persists ./data across container rebuilds. Set false so
# optional avatars and PDF documents can be stored on that disk.
PILOT_MODE=false
